* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    text-decoration: none;
    list-style: none;
    border: none;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

html {
    font-size: 62.5%;
    scroll-behavior: smooth;
}

body {
    background: #f8f5f7;
    color: #222;
    overflow-x: hidden;
}


/* NAVBAR */

.navbar {
    width: 100%;
    min-height: 8rem;
    padding: 0 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    box-shadow: 0 0.2rem 1rem rgba(0, 0, 0, 0.08);
}

.logo {
    font-size: 2.8rem;
    font-weight: 700;
    color: #333;
}

.logo-span {
    color: #5b2c4d;
}

.navbar nav {
    display: flex;
    align-items: center;
    gap: 2.5rem;
}

.navbar nav a {
    color: #333;
    font-size: 1.5rem;
    font-weight: 500;
    transition: 0.3s;
}

.navbar nav a:hover,
.navbar nav a.active {
    color: #5b2c4d;
}

.logout-btn {
    padding: 1rem 1.8rem;
    background: #5b2c4d;
    color: #ffffff !important;
    border-radius: 0.7rem;
}

.logout-btn:hover {
    background: #452139;
}


/* MAIN PAGE */

.bookings-page {
    width: 90%;
    max-width: 1200px;
    margin: 6rem auto;
}


/* HEADING */

.bookings-heading {
    text-align: center;
    margin-bottom: 5rem;
}

.small-heading {
    color: #5b2c4d;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.15rem;
    margin-bottom: 1rem;
}

.bookings-heading h1 {
    font-size: 4rem;
    font-weight: 700;
    margin-bottom: 1rem;
}

.bookings-heading > p:last-child {
    color: #777;
    font-size: 1.6rem;
}


/* BOOKING SECTION */

.bookings-section {
    margin-bottom: 5rem;
}

.section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
}

.section-title h2 {
    font-size: 2.4rem;
    color: #222;
}

.section-title span {
    padding: 0.6rem 1.2rem;
    background: #eee7ec;
    color: #5b2c4d;
    border-radius: 2rem;
    font-size: 1.3rem;
    font-weight: 600;
}


/* BOOKING LIST */

.booking-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}


/* BOOKING CARD */

.booking-card {
    display: flex;
    width: 100%;
    min-height: 22rem;
    background: #ffffff;
    border: 1px solid #eeeeee;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.06);
    transition: 0.3s ease;
}

.booking-card:hover {
    transform: translateY(-0.3rem);
    box-shadow: 0 0.8rem 2.5rem rgba(0, 0, 0, 0.1);
}


/* IMAGE */

.booking-image {
    width: 25rem;
    flex-shrink: 0;
}

.booking-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}


/* BOOKING INFORMATION */

.booking-info {
    flex: 1;
    padding: 2.5rem 3rem;
}

.booking-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
}

.booking-top h3 {
    font-size: 2.2rem;
    color: #222;
    margin-bottom: 0.7rem;
}

.location {
    color: #777;
    font-size: 1.4rem;
}


/* STATUS */

.status {
    display: inline-block;
    padding: 0.7rem 1.3rem;
    border-radius: 2rem;
    font-size: 1.3rem;
    font-weight: 600;
    white-space: nowrap;
}

.confirmed {
    color: #1d7a3d;
    background: #e8f6ed;
}

.completed-status {
    color: #3565c9;
    background: #eaf0ff;
}

.cancelled-status {
    color: #c62828;
    background: #fdeaea;
}


/* BOOKING DETAILS */

.booking-details {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding: 1.8rem 0;
    border-top: 1px solid #eeeeee;
    border-bottom: 1px solid #eeeeee;
}

.booking-details div {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
}

.booking-details span {
    color: #888;
    font-size: 1.3rem;
}

.booking-details strong {
    color: #333;
    font-size: 1.5rem;
    font-weight: 600;
}


/* ACTION BUTTONS */

.booking-actions {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 2rem;
}

.view-btn,
.cancel-btn {
    padding: 1rem 1.8rem;
    border-radius: 0.7rem;
    font-size: 1.4rem;
    font-weight: 600;
    cursor: pointer;
    transition: 0.3s ease;
}

.view-btn {
    background: #5b2c4d;
    color: #ffffff;
}

.view-btn:hover {
    background: #452139;
}

.cancel-btn {
    background: #ffffff;
    color: #d32f2f;
    border: 1px solid #d32f2f;
}

.cancel-btn:hover {
    background: #d32f2f;
    color: #ffffff;
}


/* COMPLETED BOOKING */

.booking-card.completed {
    opacity: 0.92;
}


/* CANCELLED BOOKING */

.booking-card.cancelled {
    opacity: 0.75;
}


/* FOOTER */

footer {
    background: #2d1a27;
    color: #ffffff;
    padding: 5rem 7% 2rem;
}

.footer-content {
    max-width: 1200px;
    margin: auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 5rem;
}

.footer-content .logo {
    color: #ffffff;
    margin-bottom: 1.2rem;
}

.footer-content p {
    color: #cccccc;
    font-size: 1.4rem;
    line-height: 1.7;
}

.footer-content h3 {
    font-size: 1.7rem;
    margin-bottom: 1.5rem;
}

.footer-content a {
    display: block;
    color: #cccccc;
    font-size: 1.4rem;
    margin-bottom: 1rem;
    transition: 0.3s;
}

.footer-content a:hover {
    color: #ffffff;
}

.copyright {
    max-width: 1200px;
    margin: 4rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid #493442;
    text-align: center;
    color: #aaaaaa;
    font-size: 1.3rem;
}


/* TABLET */

@media (max-width: 900px) {

    html {
        font-size: 58%;
    }

    .navbar {
        padding: 0 4%;
    }

    .navbar nav {
        gap: 1.5rem;
    }

    .bookings-page {
        width: 92%;
    }

    .booking-image {
        width: 20rem;
    }

    .booking-details {
        grid-template-columns: repeat(2, 1fr);
    }

    .footer-content {
        grid-template-columns: 1fr 1fr;
    }
}


/* MOBILE */

@media (max-width: 600px) {

    html {
        font-size: 55%;
    }

    .navbar {
        min-height: auto;
        padding: 1.8rem 5%;
        flex-direction: column;
        gap: 1.5rem;
    }

    .navbar nav {
        width: 100%;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem 1.5rem;
    }

    .bookings-page {
        width: 92%;
        margin: 4rem auto;
    }

    .bookings-heading {
        margin-bottom: 3.5rem;
    }

    .bookings-heading h1 {
        font-size: 3rem;
    }

    .section-title {
        align-items: flex-start;
        gap: 1rem;
    }

    .section-title h2 {
        font-size: 2rem;
    }

    .booking-card {
        flex-direction: column;
    }

    .booking-image {
        width: 100%;
        height: 20rem;
    }

    .booking-info {
        padding: 2rem;
    }

    .booking-top {
        flex-direction: column;
        gap: 1.2rem;
    }

    .booking-details {
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .booking-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .view-btn,
    .cancel-btn {
        width: 100%;
        text-align: center;
    }

    .footer-content {
        grid-template-columns: 1fr;
        gap: 3rem;
    }
}